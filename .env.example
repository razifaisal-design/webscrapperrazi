# Salin file ini menjadi .env (file .env TIDAK ikut ke GitHub) lalu isi nilainya.
# Cadangan ke Supabase: Connection string dari dasbor Supabase > Project Settings > Database > "Session pooler"
# (ganti [YOUR-PASSWORD] dengan kata sandi database proyek). Jangan bagikan baris ini ke siapa pun.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
